ACCION calcular_recta ES
    AMBIENTE
        vector2 = REGISTRO
            vx: REAL;
            vy: REAL;
        FIN_REGISTRO

        pori     : vector2;   // P0 — punto de origen en la recta
        dir      : vector2;   // D  — vector direccion
        pini     : vector2;   // extremo inicial del segmento visible
        pfin     : vector2;   // extremo final del segmento visible
        tini     : REAL;      // parametro t en el borde izquierdo del dominio
        tfin     : REAL;      // parametro t en el borde derecho del dominio
        dommin   : REAL;      // limite visible izquierdo (-4)
        dommax   : REAL;      // limite visible derecho  ( 4)
        coord    : ENTERO;
        cero     : ENTERO;
        t_eje_x  : AN(6);
        t_eje_y  : AN(6);
        t_tick_x : AN(7);
        t_tick_y : AN(7);
        t_label_x: AN(8);
        t_label_y: AN(8);
        t_label_o: AN(8);
        t_linea  : AN(6);
        esp      : AN(1);

    PROCESO
        t_eje_x   := "EJE_X";
        t_eje_y   := "EJE_Y";
        t_tick_x  := "TICK_X";
        t_tick_y  := "TICK_Y";
        t_label_x := "LABEL_X";
        t_label_y := "LABEL_Y";
        t_label_o := "LABEL_O";
        t_linea   := "LINEA";
        esp       := " ";
        cero      := 0;
        dommin    := -4;
        dommax    :=  4;

        // --- EJES ---
        ESCRIBIR(t_eje_x);
        ESCRIBIR(t_eje_y);

        // --- TICKS Y LABELS: de -4 a 4 ---
        PARA coord := -4 HASTA 4 HACER
            ESCRIBIR(t_tick_x,esp,coord);
            ESCRIBIR(t_tick_y,esp,coord);
            SI coord <> 0 ENTONCES
                ESCRIBIR(t_label_x,esp,coord,esp,coord);
                ESCRIBIR(t_label_y,esp,coord,esp,coord);
            FIN_SI
        FIN_PARA
        ESCRIBIR(t_label_o,esp,cero);

        // --- RECTA PARAMETRICA: P(t) = P0 + t * D ---
        // Definir el origen y la direccion — esto es lo unico que cambia
        // para representar cualquier recta
        pori.vx := 0;
        pori.vy := 0;
        dir.vx  := 1;
        dir.vy  := -4;

        // Calcular t para los bordes del dominio visible
        // despejando: x = P0.vx + t * D.vx  →  t = (x - P0.vx) / D.vx
        tini := (dommin - pori.vx) / dir.vx;
        tfin := (dommax - pori.vx) / dir.vx;

        // Calcular los extremos del segmento visible: P = P0 + t * D
        pini.vx := pori.vx + tini * dir.vx;
        pini.vy := pori.vy + tini * dir.vy;
        pfin.vx := pori.vx + tfin * dir.vx;
        pfin.vy := pori.vy + tfin * dir.vy;

        ESCRIBIR(t_linea,esp,pini.vx,esp,pini.vy,esp,pfin.vx,esp,pfin.vy);

FIN_ACCION
