        },
        {
          "nombre": "ancho",
          "tipo": "EXPR"
        },
        {
          "nombre": "alto",
          "tipo": "EXPR"
        },
        {
          "nombre": "color",
          "tipo": "TEXTO"
        }
      ]
    },
    {
      "nombre": "FRAME_FIN",
      "efecto": "cerrar el cuadro, escalarlo y mostrarlo",
      "params": []
    }
  ]
}
