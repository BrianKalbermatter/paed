{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Paed",
    "scopeName": "source.paed",
    "fileTypes": ["paed"],
    "_generado": "NO EDITAR A MANO — sale de data/sintaxis.json via tools/generar.sh",
    "patterns": [
        { "include": "#condicionales" },
        { "include": "#bucles" },
        { "include": "#estructura" },
        { "include": "#salida" },
        { "include": "#entrada" },
        { "include": "#tipos" },
        { "include": "#operadores" },
        { "include": "#funciones_builtin" },
        { "include": "#secuencias" },
        { "include": "#booleanos" },
        { "include": "#comentario" },
        { "include": "#strings" },
        { "include": "#strings_simples" },
        { "include": "#numeros" }
    ],
    "repository": {
        "condicionales": { "match": "\\b(SI|FIN_SI|SINO|CONTRARIO|ENTONCES)\\b", "name": "keyword.control.condicional.paed" },
        "bucles": { "match": "\\b(MIENTRAS|FIN_MIENTRAS|PARA|FIN_PARA|REPETIR|HASTA|HACER)\\b", "name": "keyword.control.bucle.paed" },
        "estructura": { "match": "\\b(ACCION|ES|FIN_ACCION|FINACCION|PROCESO|AMBIENTE|FUNCION|FIN_FUNCION|PROCEDIMIENTO|FIN_PROCEDIMIENTO|RETORNAR|SEGUN|FIN_SEGUN|ABRIR|CERRAR|ARCHIVO|REGISTRO|FIN_REGISTRO)\\b", "name": "keyword.other.estructura.paed" },
        "salida": { "match": "\\b(ESCRIBIR)\\b", "name": "support.function.salida.paed" },
        "entrada": { "match": "\\b(LEER)\\b", "name": "support.function.entrada.paed" },
        "tipos": { "match": "\\b(ENTEROS|ENTERO|REAL|CARACTER|CARACTERES|BOOLEANO|SECUENCIA|VENTANA|SALIDA|ARREGLO|CONSTANTE|VAR|DE|AN|N)\\b", "name": "storage.type.paed" },
        "operadores": { "match": "\\b(Y|O|NO|AND|OR|MOD|DIV)\\b", "name": "keyword.operator.logico.paed" },
        "funciones_builtin": { "match": "\\b(TRUNC|ABSO|REDOND)\\b", "name": "support.function.builtin.paed" },
        "secuencias": { "match": "\\b(ARR|AVZ|CREAR|VENTANA|NFDS|FDS)\\b", "name": "support.function.secuencia.paed" },
        "booleanos": { "match": "\\b(V|F)\\b", "name": "constant.language.boolean.paed" },
        "comentario": { "match": "//.*$", "name": "comment.line.double-slash.paed" },
        "strings": { "begin": "\"", "end": "\"", "name": "string.quoted.double.paed" },
        "strings_simples": { "begin": "'", "end": "'", "name": "string.quoted.single.paed" },
        "numeros": { "match": "\\b[0-9]+(\\.[0-9]+)?\\b", "name": "constant.numeric.paed" }
    }
}
