#!/bin/bash
source ./core/flags.sh
source ./core/validacion.sh
source ./stdlib/matematica.sh
# paed - Interprete/Compilador del lenguaje .paed
# Uso: ./paed nombreArchivo.paed

ARCHIVO=$1

analizar(){
    echo "analizando..."
    if [ -z "$ARCHIVO" ]; then # Si string esta vacio, Si Archivo esta vacio, error
        echo "Error: Esta vacio!"
        return 1
    fi

    if [ ! -f "$ARCHIVO" ]; then # Existe el archivo?
        echo "Error: no existe el archivo"
        return 1
    fi

    if [ ${ARCHIVO##*.} == "paed" ]; then #
        echo "Extension .paed"
    else
        echo "No es extension .paed"
        return 1
    fi

    # Pila para bloques anidados: guarda keyword + línea donde se abrió
    pila_palabras=()
    pila_lineas=()
    pila_top=0

    linea_num=0
    hay_errores=0

    while IFS= read -r linea; do
        # Quitar espacios al inicio para leer la primera palabra limpia
        linea_trim="${linea#"${linea%%[! ]*}"}"
        set -- $linea_trim
        linea_num=$((linea_num + 1))

        # Normalizar sintaxis flexible antes de analizar
        if [[ "$linea_trim" == MIENTRAS\(* ]]; then
            local inner="${linea_trim#MIENTRAS(}"
            inner="${inner%) HACER}"; inner="${inner%)}"
            linea_trim="MIENTRAS $inner HACER"
        fi
        if [[ "$linea_trim" == SI\(* ]]; then
            local inner="${linea_trim#SI(}"
            inner="${inner%) ENTONCES}"; inner="${inner%)}"
            linea_trim="SI $inner ENTONCES"
        fi
        set -- $linea_trim

        # Ignorar líneas vacías y comentarios
        [ -z "$1" ] && continue
        case $1 in //*) continue ;; esac

        #--------------------------------
        # Estructura global ACCION..ES
        case $1 in
            ACCION) find_ACCION=1 ;;
        esac

        eval last=\$$#
        case $last in
            ES)       find_ES=1 ;;
            HACER)    find_HACER=1 ;;
            ENTONCES) find_ENTONCES=1 ;;
        esac

        #--------------------------------
        # Bloques que van solos en su línea
        case $linea_trim in
            AMBIENTE)
                if [ $find_ACCION -eq 1 ] && [ $find_AMBIENTE -eq 0 ]; then
                    find_AMBIENTE=1
                else
                    echo "$ARCHIVO:$linea_num: error: AMBIENTE inesperado"
                    hay_errores=1
                fi
                ;;
            PROCESO)
                if [ $find_ACCION -eq 1 ] && [ $find_AMBIENTE -eq 1 ] && [ $find_PROCESO -eq 0 ]; then
                    find_PROCESO=1
                else
                    echo "$ARCHIVO:$linea_num: error: PROCESO inesperado"
                    hay_errores=1
                fi
                ;;
            FIN_ACCION)
                if [ $find_ACCION -eq 1 ] && [ $find_FIN_ACCION -eq 0 ]; then
                    find_FIN_ACCION=1
                else
                    echo "$ARCHIVO:$linea_num: error: FIN_ACCION inesperado"
                    hay_errores=1
                fi
                ;;
        esac

        #--------------------------------
        # Pila: apertura de bloques
        case $1 in
            SI)
                pila_palabras[$pila_top]="SI"
                pila_lineas[$pila_top]=$linea_num
                pila_top=$((pila_top + 1))
                ;;
            MIENTRAS)
                pila_palabras[$pila_top]="MIENTRAS"
                pila_lineas[$pila_top]=$linea_num
                pila_top=$((pila_top + 1))
                ;;
            PARA)
                pila_palabras[$pila_top]="PARA"
                pila_lineas[$pila_top]=$linea_num
                pila_top=$((pila_top + 1))
                ;;
            FUNCION)
                pila_palabras[$pila_top]="FUNCION"
                pila_lineas[$pila_top]=$linea_num
                pila_top=$((pila_top + 1))
                ;;
            PROCEDIMIENTO)
                pila_palabras[$pila_top]="PROCEDIMIENTO"
                pila_lineas[$pila_top]=$linea_num
                pila_top=$((pila_top + 1))
                ;;
            SEGUN)
                pila_palabras[$pila_top]="SEGUN"
                pila_lineas[$pila_top]=$linea_num
                pila_top=$((pila_top + 1))
                ;;
            REPETIR)
                pila_palabras[$pila_top]="REPETIR"
                pila_lineas[$pila_top]=$linea_num
                pila_top=$((pila_top + 1))
                ;;
        esac

        # Pila: cierre de bloques — verificar que corresponde con la apertura
        case $1 in
            FIN_SI)
                pila_top=$((pila_top - 1))
                if [ $pila_top -lt 0 ] || [ "${pila_palabras[$pila_top]}" != "SI" ]; then
                    echo "$ARCHIVO:$linea_num: error: FIN_SI sin SI correspondiente"
                    hay_errores=1
                    [ $pila_top -lt 0 ] && pila_top=0
                fi
                ;;
            FIN_MIENTRAS)
                pila_top=$((pila_top - 1))
                if [ $pila_top -lt 0 ] || [ "${pila_palabras[$pila_top]}" != "MIENTRAS" ]; then
                    echo "$ARCHIVO:$linea_num: error: FIN_MIENTRAS sin MIENTRAS correspondiente"
                    hay_errores=1
                    [ $pila_top -lt 0 ] && pila_top=0
                fi
                ;;
            FIN_PARA)
                pila_top=$((pila_top - 1))
                if [ $pila_top -lt 0 ] || [ "${pila_palabras[$pila_top]}" != "PARA" ]; then
                    echo "$ARCHIVO:$linea_num: error: FIN_PARA sin PARA correspondiente"
                    hay_errores=1
                    [ $pila_top -lt 0 ] && pila_top=0
                fi
                ;;
            FIN_FUNCION)
                pila_top=$((pila_top - 1))
                if [ $pila_top -lt 0 ] || [ "${pila_palabras[$pila_top]}" != "FUNCION" ]; then
                    echo "$ARCHIVO:$linea_num: error: FIN_FUNCION sin FUNCION correspondiente"
                    hay_errores=1
                    [ $pila_top -lt 0 ] && pila_top=0
                fi
                ;;
            FIN_PROCEDIMIENTO)
                pila_top=$((pila_top - 1))
                if [ $pila_top -lt 0 ] || [ "${pila_palabras[$pila_top]}" != "PROCEDIMIENTO" ]; then
                    echo "$ARCHIVO:$linea_num: error: FIN_PROCEDIMIENTO sin PROCEDIMIENTO correspondiente"
                    hay_errores=1
                    [ $pila_top -lt 0 ] && pila_top=0
                fi
                ;;
            HASTA)
                pila_top=$((pila_top - 1))
                if [ $pila_top -lt 0 ] || [ "${pila_palabras[$pila_top]}" != "REPETIR" ]; then
                    echo "$ARCHIVO:$linea_num: error: HASTA sin REPETIR correspondiente"
                    hay_errores=1
                    [ $pila_top -lt 0 ] && pila_top=0
                fi
                ;;
            FIN_SEGUN|FinSegun|FSegun)
                pila_top=$((pila_top - 1))
                if [ $pila_top -lt 0 ] || [ "${pila_palabras[$pila_top]}" != "SEGUN" ]; then
                    echo "$ARCHIVO:$linea_num: error: FIN_SEGUN sin SEGUN correspondiente"
                    hay_errores=1
                    [ $pila_top -lt 0 ] && pila_top=0
                fi
                ;;
        esac
        #--------------------------------

    done < "$ARCHIVO"

    # Bloques que quedaron abiertos sin cerrar → el error apunta a donde se ABRIÓ
    while [ $pila_top -gt 0 ]; do
        pila_top=$((pila_top - 1))
        kw="${pila_palabras[$pila_top]}"
        ln="${pila_lineas[$pila_top]}"
        echo "$ARCHIVO:$ln: error: $kw sin cierre (falta FIN_$kw)"
        hay_errores=1
    done

    validacion_end
    [ $hay_errores -eq 0 ] && return 0 || return 1
}


# Sustituye llamadas a funciones predefinidas en una expresión.
# Ej: "MOD(10, 3) + 1"  →  "1 + 1"
resolver_funciones() {
    local expr="$1"
    local re2 re1 r

    # Regex en variables: bash =~ los interpreta sin escapes extra
    re2='MOD\(([^,)]+),([^)]+)\)'
    while [[ "$expr" =~ $re2 ]]; do
        r=$(_paed_MOD "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")
        expr="${expr/${BASH_REMATCH[0]}/$r}"
    done

    re2='DIV\(([^,)]+),([^)]+)\)'
    while [[ "$expr" =~ $re2 ]]; do
        r=$(_paed_DIV "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")
        expr="${expr/${BASH_REMATCH[0]}/$r}"
    done

    re1='TRUNC\(([^)]+)\)'
    while [[ "$expr" =~ $re1 ]]; do
        r=$(_paed_TRUNC "${BASH_REMATCH[1]}")
        expr="${expr/${BASH_REMATCH[0]}/$r}"
    done

    re1='ABSO\(([^)]+)\)'
    while [[ "$expr" =~ $re1 ]]; do
        r=$(_paed_ABSO "${BASH_REMATCH[1]}")
        expr="${expr/${BASH_REMATCH[0]}/$r}"
    done

    re1='REDOND\(([^)]+)\)'
    while [[ "$expr" =~ $re1 ]]; do
        r=$(_paed_REDOND "${BASH_REMATCH[1]}")
        expr="${expr/${BASH_REMATCH[0]}/$r}"
    done

    echo "$expr"
}

ejecutar() {
    echo "ejecutando..."
    declare -A variables
    set -f

    # Cargar todas las líneas en un array para poder saltar (necesario para loops)
    declare -a lns
    local total=0
    while IFS= read -r _l; do
        lns[$total]="$_l"
        total=$((total + 1))
    done < "$ARCHIVO"

    local en_ambiente=0
    local en_proceso=0
    declare -a loop_stk     # pila MIENTRAS: guarda índice de línea
    local loop_top=0
    declare -a rep_stk      # pila REPETIR: guarda índice de línea
    local rep_top=0
    declare -a para_ln      # pila PARA: línea de inicio del PARA
    declare -a para_var     # pila PARA: nombre de la variable contadora
    declare -a para_lim     # pila PARA: límite superior
    local para_top=0

    # ── Estado de secuencias y ventanas ──────────────────────────────────
    # _seq_len[nombre]    = cantidad de elementos en la secuencia
    # _seq_el[nombre_idx] = elemento en posición idx
    # _vent_seq[ventana]  = nombre de la secuencia a la que apunta la ventana
    # _vent_idx[ventana]  = índice actual de la ventana
    declare -A _seq_len
    declare -A _seq_el
    declare -A _vent_seq
    declare -A _vent_idx

    # ── Registro de tipos REGISTRO definidos en el archivo ───────────────
    # _reg_campos["NombreTipo"] = "campo1 campo2 campo3"
    declare -A _reg_campos
    local _en_reg=0
    local _reg_nombre=""
    local _reg_lista=""
    for _rl in "${lns[@]}"; do
        local _rlt="${_rl#"${_rl%%[! ]*}"}"
        # Detectar "NombreTipo = REGISTRO"
        if [[ "$_rlt" =~ ^([A-Za-z_][A-Za-z0-9_]*)\ *=\ *REGISTRO$ ]]; then
            _reg_nombre="${BASH_REMATCH[1]}"
            _reg_lista=""
            _en_reg=1
        elif [ $_en_reg -eq 1 ] && [[ "$_rlt" == FIN_REGISTRO* ]]; then
            _reg_campos["$_reg_nombre"]="$_reg_lista"
            _en_reg=0
        elif [ $_en_reg -eq 1 ]; then
            # Extraer nombre del campo: "vx : REAL;" → "vx"
            local _campo="${_rlt%%:*}"
            _campo="${_campo// /}"
            _reg_lista="$_reg_lista $_campo"
        fi
    done

    local i=0
    local _en_reg_def=0   # 1 cuando estamos dentro de un bloque REGISTRO (en AMBIENTE)
    while [ $i -lt $total ]; do
        local linea="${lns[$i]}"
        local lt="${linea#"${linea%%[! ]*}"}"   # trim espacios al inicio

        # Normalizar sintaxis flexible
        if [[ "$lt" == MIENTRAS\(* ]]; then
            local inner="${lt#MIENTRAS(}"
            inner="${inner%) HACER}"; inner="${inner%)}"
            lt="MIENTRAS $inner HACER"
        fi
        if [[ "$lt" == SI\(* ]]; then
            local inner="${lt#SI(}"
            inner="${inner%) ENTONCES}"; inner="${inner%)}"
            lt="SI $inner ENTONCES"
        fi
        # Normalizar := para que siempre tenga espacios (a:=1 y a:= 1 → a := 1)
        lt="${lt//:=/:= }"

        set -- $lt

        # Control de sección
        case $lt in
            AMBIENTE)    en_ambiente=1; i=$((i+1)); continue ;;
            PROCESO)     en_ambiente=0; en_proceso=1; i=$((i+1)); continue ;;
            FIN_ACCION)  en_proceso=0; i=$((i+1)); continue ;;
            FIN_REGISTRO) _en_reg_def=0; i=$((i+1)); continue ;;
        esac

        # Detectar inicio de bloque REGISTRO (dentro o fuera de AMBIENTE)
        if [[ "$lt" =~ ^([A-Za-z_][A-Za-z0-9_]*)\ *=\ *REGISTRO$ ]]; then
            _en_reg_def=1; i=$((i+1)); continue
        fi

        # Saltear campos dentro de un bloque REGISTRO
        if [ $_en_reg_def -eq 1 ]; then
            i=$((i+1)); continue
        fi

        # ── AMBIENTE: declaraciones de variables ─────────────────────────
        if [ $en_ambiente -eq 1 ]; then
            # Procesar declaración de variable: "nombre : Tipo;"
            # Si el tipo es un REGISTRO conocido, inicializar sus campos
            local _decl="${lt%%;}"
            if [[ "$_decl" =~ ^([A-Za-z_][A-Za-z0-9_]*)\ *:\ *([A-Za-z_][A-Za-z0-9_]*)$ ]]; then
                local _vnom="${BASH_REMATCH[1]}"
                local _tipo="${BASH_REMATCH[2]}"
                if [ -n "${_reg_campos[$_tipo]+x}" ]; then
                    # Inicializar cada campo como "variable.campo" = 0
                    for _campo in ${_reg_campos[$_tipo]}; do
                        variables["$_vnom.$_campo"]=0
                    done
                fi
            fi
            i=$((i+1)); continue
        fi

        if [ $en_proceso -eq 1 ]; then

            # ── MIENTRAS condicion HACER ──────────────────────────────────
            if [ "$1" = "MIENTRAS" ]; then
                local cond="${lt#MIENTRAS }"
                cond="${cond% HACER}"
                # Sustituir variables en la condición
                for var in "${!variables[@]}"; do
                    cond="${cond//$var/${variables[$var]}}"
                done
                # Resolver NFDS(ventana) → 1 si v != "#", 0 si llegó al fin
                local _re_nfds='NFDS\(([^)]+)\)'
                while [[ "$cond" =~ $_re_nfds ]]; do
                    local _vn="${BASH_REMATCH[1]// /}"
                    local _val="${variables[$_vn]:-}"
                    local _nv=1
                    case "$_val" in
                        FDS|"#"|"*"|"%"|" "|"."|"]"|"&"|"$"|"@") _nv=0 ;;
                    esac
                    cond="${cond/${BASH_REMATCH[0]}/$_nv}"
                done
                # Traducir operadores a bc
                cond="${cond// <> / != }"
                cond="${cond// DISTINTO DE / != }"
                cond="${cond// = / == }"
                cond="${cond// Y / && }"
                cond="${cond// O / || }"
                [[ "$cond" == NO\ * ]] && cond="1 - ${cond#NO }"
                cond="${cond// NO / 1 - }"
                local res
                res=$(echo "$cond" | bc -l 2>/dev/null)
                if [ "$res" = "1" ]; then
                    # Condición verdadera: apilar posición y entrar al cuerpo
                    loop_stk[$loop_top]=$i
                    loop_top=$((loop_top + 1))
                    i=$((i+1)); continue
                else
                    # Condición falsa: saltar hasta el FIN_MIENTRAS correspondiente
                    local depth=1
                    i=$((i+1))
                    while [ $i -lt $total ] && [ $depth -gt 0 ]; do
                        local sl="${lns[$i]#"${lns[$i]%%[! ]*}"}"
                        case $sl in
                            MIENTRAS*) depth=$((depth+1)) ;;
                            FIN_MIENTRAS) depth=$((depth-1)) ;;
                        esac
                        i=$((i+1))
                    done
                    continue
                fi
            fi

            # ── FIN_MIENTRAS: volver al MIENTRAS para re-evaluar ─────────
            if [ "$1" = "FIN_MIENTRAS" ]; then
                loop_top=$((loop_top - 1))
                i=${loop_stk[$loop_top]}
                continue   # no incrementar i: vuelve al MIENTRAS
            fi

            # ── PARA var := inicio a fin HACER ───────────────────────────
            if [ "$1" = "PARA" ]; then
                # Sintaxis: PARA var := inicio a fin HACER
                local pvar="$2"
                local pinicio="$4"
                local pfin="$6"
                # Sustituir variables en inicio y fin
                for var in "${!variables[@]}"; do
                    pinicio="${pinicio//$var/${variables[$var]}}"
                    pfin="${pfin//$var/${variables[$var]}}"
                done
                pinicio=$(echo "scale=0; ($pinicio)/1" | bc -l 2>/dev/null)
                pfin=$(echo "scale=0; ($pfin)/1" | bc -l 2>/dev/null)
                # Si el contador ya existe en la pila (vuelta del FIN_PARA), no reiniciar
                local _ya_apilado=0
                if [ $para_top -gt 0 ] && [ "${para_var[$((para_top-1))]}" = "$pvar" ] && [ "${para_ln[$((para_top-1))]}" = "$i" ]; then
                    _ya_apilado=1
                fi
                if [ $_ya_apilado -eq 0 ]; then
                    # Primera vez: inicializar variable y apilar estado
                    variables[$pvar]=$pinicio
                    para_ln[$para_top]=$i
                    para_var[$para_top]=$pvar
                    para_lim[$para_top]=$pfin
                    para_top=$((para_top + 1))
                fi
                # Evaluar condición: variable <= límite
                local _cur="${variables[$pvar]}"
                local _lim="${para_lim[$((para_top-1))]}"
                local _cond
                _cond=$(echo "scale=0; $_cur <= $_lim" | bc -l 2>/dev/null)
                if [ "$_cond" = "1" ]; then
                    i=$((i+1)); continue
                else
                    # Límite superado: desapilar y saltar hasta FIN_PARA
                    para_top=$((para_top - 1))
                    local depth=1
                    i=$((i+1))
                    while [ $i -lt $total ] && [ $depth -gt 0 ]; do
                        local sl="${lns[$i]#"${lns[$i]%%[! ]*}"}"
                        case $sl in
                            PARA\ *) depth=$((depth+1)) ;;
                            FIN_PARA) depth=$((depth-1)) ;;
                        esac
                        i=$((i+1))
                    done
                    continue
                fi
            fi

            # ── FIN_PARA: incrementar y volver al PARA ────────────────────
            if [ "$1" = "FIN_PARA" ]; then
                local _pv="${para_var[$((para_top-1))]}"
                local _cur="${variables[$_pv]}"
                variables[$_pv]=$(echo "scale=0; ($_cur + 1)/1" | bc -l 2>/dev/null)
                i=${para_ln[$((para_top-1))]}
                continue
            fi

            # ── SI condicion ENTONCES ────────────────────────────────────
            if [ "$1" = "SI" ]; then
                local cond="${lt#SI }"
                cond="${cond% ENTONCES}"
                # Sustituir variables
                for var in "${!variables[@]}"; do
                    cond="${cond//$var/${variables[$var]}}"
                done
                # Traducir operadores a bc
                cond="${cond// <> / != }"
                cond="${cond// DISTINTO DE / != }"
                cond="${cond// = / == }"
                cond="${cond// Y / && }"
                cond="${cond// O / || }"
                [[ "$cond" == NO\ * ]] && cond="1 - ${cond#NO }"
                cond="${cond// NO / 1 - }"
                local res
                res=$(echo "$cond" | bc -l 2>/dev/null)
                if [ "$res" = "1" ]; then
                    # Condición verdadera: entrar al cuerpo normalmente
                    i=$((i+1)); continue
                else
                    # Condición falsa: saltar hasta SINO o FIN_SI
                    local depth=1
                    i=$((i+1))
                    while [ $i -lt $total ] && [ $depth -gt 0 ]; do
                        local sl="${lns[$i]#"${lns[$i]%%[! ]*}"}"
                        case $sl in
                            SI\ *|SI\(*) depth=$((depth+1)) ;;
                            FIN_SI)      depth=$((depth-1)) ;;
                            SINO)        [ $depth -eq 1 ] && { i=$((i+1)); break; } ;;
                        esac
                        [ $depth -gt 0 ] && i=$((i+1))
                    done
                    continue
                fi
            fi

            # ── SINO: SI fue verdadero, saltar hasta FIN_SI ───────────────
            if [ "$1" = "SINO" ]; then
                local depth=1
                i=$((i+1))
                while [ $i -lt $total ] && [ $depth -gt 0 ]; do
                    local sl="${lns[$i]#"${lns[$i]%%[! ]*}"}"
                    case $sl in
                        SI\ *|SI\(*) depth=$((depth+1)) ;;
                        FIN_SI)      depth=$((depth-1)) ;;
                    esac
                    [ $depth -gt 0 ] && i=$((i+1))
                done
                i=$((i+1)); continue
            fi

            # ── FIN_SI: fin del bloque condicional ────────────────────────
            if [ "$1" = "FIN_SI" ]; then
                i=$((i+1)); continue
            fi

            # ── REPETIR: marcar inicio del cuerpo (post-test) ────────────
            if [ "$1" = "REPETIR" ]; then
                if [ $rep_top -eq 0 ] || [ "${rep_stk[$((rep_top-1))]}" != "$i" ]; then
                    rep_stk[$rep_top]=$i
                    rep_top=$((rep_top + 1))
                fi
                i=$((i+1)); continue
            fi

            # ── HASTA condicion: evaluar, salir o volver ─────────────────
            if [ "$1" = "HASTA" ]; then
                local cond="${lt#HASTA }"
                for var in "${!variables[@]}"; do
                    cond="${cond//$var/${variables[$var]}}"
                done
                local _re_nfds='NFDS\(([^)]+)\)'
                while [[ "$cond" =~ $_re_nfds ]]; do
                    local _vn="${BASH_REMATCH[1]// /}"
                    local _val="${variables[$_vn]:-}"
                    local _nv=1
                    case "$_val" in
                        FDS|"#"|"*"|"%"|" "|"."|"]"|"&"|"$"|"@") _nv=0 ;;
                    esac
                    cond="${cond/${BASH_REMATCH[0]}/$_nv}"
                done
                cond="${cond// Y / && }"
                cond="${cond// O / || }"
                [[ "$cond" == NO\ * ]] && cond="1 - ${cond#NO }"
                cond="${cond// NO / 1 - }"
                local res
                res=$(echo "$cond" | bc -l 2>/dev/null)
                if [ "$res" = "1" ]; then
                    # Condición cumplida: salir del loop
                    rep_top=$((rep_top - 1))
                    i=$((i+1)); continue
                else
                    # Condición no cumplida: volver al REPETIR
                    i=${rep_stk[$((rep_top-1))]}
                    continue
                fi
            fi

            # ── ARR(ventana, secuencia): posicionar ventana al inicio ─────
            # Sintaxis: ARR(v, s);
            if [[ "$lt" == ARR\(* ]]; then
                local _args="${lt#ARR(}"
                _args="${_args%)*}"; _args="${_args%;}"
                IFS=',' read -ra _partes <<< "$_args"
                local _vname="${_partes[0]// /}"
                local _sname="${_partes[1]// /}"
                _vent_seq["$_vname"]="$_sname"
                _vent_idx["$_vname"]=0
                # La ventana contiene el primer elemento
                variables["$_vname"]="${_seq_el[${_sname}_0]:-}"
                i=$((i+1)); continue
            fi

            # ── AVZ(ventana): avanzar al siguiente elemento ───────────────
            # Sintaxis: AVZ(v);
            if [[ "$lt" == AVZ\(* ]]; then
                local _vname="${lt#AVZ(}"
                _vname="${_vname%)*}"; _vname="${_vname%;}"
                local _sname="${_vent_seq[$_vname]:-}"
                local _new_idx=$(( ${_vent_idx[$_vname]:-0} + 1 ))
                _vent_idx["$_vname"]=$_new_idx
                # Actualizar el valor de la ventana (vacío si se pasó del fin)
                variables["$_vname"]="${_seq_el[${_sname}_${_new_idx}]:-}"
                i=$((i+1)); continue
            fi

            # ── CERRAR(secuencia, ventana): liberar secuencia y ventana ──
            # Sintaxis: CERRAR(s, v);
            if [[ "$lt" == CERRAR\(* ]]; then
                local _args="${lt#CERRAR(}"
                _args="${_args%)*}"; _args="${_args%;}"
                IFS=',' read -ra _partes <<< "$_args"
                local _sname="${_partes[0]// /}"
                local _vname="${_partes[1]// /}"
                unset "_seq_len[$_sname]"
                unset "_vent_seq[$_vname]"
                unset "_vent_idx[$_vname]"
                unset "variables[$_vname]"
                i=$((i+1)); continue
            fi

            # ── Asignación: var := valor; ─────────────────────────────────
            if [ "$2" = ":=" ]; then
                local rhs="${@:3}"
                rhs="${rhs%;}"

                # Arreglo/secuencia: s := ("a","b","c");
                # Solo si empieza con ( Y tiene comas → es secuencia
                # Si empieza con ( sin comas → es expresion matematica con parentesis
                if [[ "$rhs" == \(* ]] && [[ "$rhs" == *,* ]]; then
                    local _snom="$1"
                    local _rest="${rhs#(}"
                    _rest="${_rest%)*}"; _rest="${_rest%;}"
                    local _idx=0
                    IFS=',' read -ra _elems <<< "$_rest"
                    for _elem in "${_elems[@]}"; do
                        _elem="${_elem// /}"
                        _elem="${_elem//\"/}"
                        _elem="${_elem//\'/}"
                        _seq_el["${_snom}_${_idx}"]="$_elem"
                        _idx=$((_idx + 1))
                    done
                    _seq_len["$_snom"]=$_idx
                else
                    # Variable escalar normal
                    for var in "${!variables[@]}"; do
                        rhs="${rhs//$var/${variables[$var]}}"
                    done
                    rhs=$(resolver_funciones "$rhs")
                    local resultado
                    resultado=$(echo "scale=6; $rhs" | bc -l 2>/dev/null)
                    if [ $? -eq 0 ] && [ -n "$resultado" ]; then
                        variables[$1]=$resultado
                    else
                        rhs="${rhs//\"/}"
                        variables[$1]=$rhs
                    fi
                fi
            fi

            # ── ESCRIBIR(var1,var2,"literal"); ───────────────────────────
            if [[ "$lt" == ESCRIBIR* ]]; then
                local args="${lt#ESCRIBIR(}"
                args="${args%)*}"
                IFS=',' read -ra lista <<< "$args"
                for nombre in "${lista[@]}"; do
                    # trim espacios al inicio y al final
                    nombre="${nombre#"${nombre%%[! ]*}"}"
                    nombre="${nombre%"${nombre##*[! ]}"}"
                    if [[ "$nombre" == \"*\" ]] || [[ "$nombre" == \'*\' ]]; then
                        # string literal: sacar las comillas y imprimir directo
                        printf "%s" "${nombre:1:${#nombre}-2}"
                    else
                        # variable
                        printf "%s" "${variables[$nombre]}"
                    fi
                done
                echo ""
            fi

            # ── LEER(var); ────────────────────────────────────────────────
            if [[ "$1" == LEER* ]]; then
                local nombre="${1#LEER(}"
                nombre="${nombre%)*}"
                read "variables[$nombre]"
            fi

        fi

        i=$((i+1))
    done
    set +f
}

