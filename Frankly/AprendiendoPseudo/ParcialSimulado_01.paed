// ════════════════════════════════════════════════════════════════════════════
//  PARCIAL SIMULADO Nº 1 — Algoritmos y Estructuras de Datos
//  UTN FRRe
//
//  Cinco ejercicios tomados de la guia de la catedra. Los enunciados salen de
//  data/niveles.json y de solutions/AlgoritmosSimples_Nivel*, no son
//  inventados.
//
//  Los datos ENTRAN POR TECLADO, como en un parcial de verdad:
//
//      paed Frankly/AprendiendoPseudo/ParcialSimulado_01.paed
//
//  y vas contestando. Para correrlo sin tipear, los datos de ejemplo estan al
//  final en el bloque ENTRADA:
//
//      f=ParcialSimulado_01.paed
//      sed -n '/^\/\/ .. ENTRADA/,$p' $f | sed '1d;s|^// \?||' | paed $f
//
//  (el patron va anclado al principio de linea, si no matchea esta misma
//   linea del comentario que lo explica)
//
//  UNA LINEA POR DATO. `LEER(a, b, c)` consume TRES lineas, no una linea con
//  tres numeros.
// ════════════════════════════════════════════════════════════════════════════

ACCION parcial_simulado_01 ES
    AMBIENTE
        // ── Ejercicio 5: registro para el resumen del curso ──
        resumen = REGISTRO
            aprobados: ENTERO;
            desaprobados: ENTERO;
            promedio: REAL;
            maxima: REAL;
        FIN_REGISTRO

        // Ej 1 — Precio con inflacion
        C: REAL;
        R: REAL;
        A: ENTERO;
        N: ENTERO;
        P: REAL;

        // Ej 2 — Discriminante
        a: REAL;
        b: REAL;
        c: REAL;
        D: REAL;
        x1: REAL;
        x2: REAL;

        // Ej 3 — Precio PC + impresora
        cant_pc: ENTERO;
        cant_imp: ENTERO;
        precio_pc: REAL;
        precio_imp: REAL;
        desc: REAL;
        subtotal_pc: REAL;
        subtotal_imp: REAL;
        total: REAL;

        // Ej 4 — Notas de un alumno
        n1: REAL;
        n2: REAL;
        n3: REAL;
        prom: REAL;

        // Ej 5 — Registro de notas del curso
        notas: ARREGLO[1..12] DE REAL;
        nota: REAL;
        cant: ENTERO;
        i: ENTERO;
        suma: REAL;
        curso: resumen;

    PROCESO
        ESCRIBIR("===== PARCIAL SIMULADO Nº 1 — AED =====");
        ESCRIBIR("");

        // ────────────────────────────────────────────────────────────────────
        // EJERCICIO 1 (Guia 1.1.5.1) — Precio con inflacion
        //
        //   Calcular el precio de un articulo para un anio dado, sabiendo que
        //   la inflacion es del 4% anual.        P = C * (1 + R) ** (N - A)
        // ────────────────────────────────────────────────────────────────────
        ESCRIBIR("── Ejercicio 1: precio con inflacion ──");

        ESCRIBIR("costo actual del articulo:");
        LEER(C);
        ESCRIBIR("inflacion anual (0.04 es 4%):");
        LEER(R);
        ESCRIBIR("anio actual y anio a calcular:");
        LEER(A, N);

        P := C * (1 + R) ** (N - A);

        ESCRIBIR("costo hoy: $", C, "   inflacion: ", R * 100, "%");
        ESCRIBIR("de ", A, " a ", N, " son ", N - A, " anios");
        ESCRIBIR("precio en ", N, ": $", P);
        ESCRIBIR("");

        // ────────────────────────────────────────────────────────────────────
        // EJERCICIO 2 (Guia 1.1.5.2) — Discriminante
        //
        //   Las raices de ax^2 + bx + c = 0 son reales si y solo si el
        //   discriminante (b^2 - 4ac) no es negativo. Informar el resultado.
        // ────────────────────────────────────────────────────────────────────
        ESCRIBIR("── Ejercicio 2: discriminante ──");

        // Tres destinos en UN solo LEER: consume tres lineas, una por variable
        ESCRIBIR("coeficientes a, b y c:");
        LEER(a, b, c);

        D := b ** 2 - 4 * a * c;

        ESCRIBIR("ecuacion: ", a, "x^2 + ", b, "x + ", c, " = 0");
        ESCRIBIR("discriminante: ", D);

        SI (D > 0) ENTONCES
            // Sin funcion raiz en el lenguaje, se usa el exponente 1/2
            x1 := (-b + D ** 0.5) / (2 * a);
            x2 := (-b - D ** 0.5) / (2 * a);
            ESCRIBIR("dos raices reales distintas: ", x1, " y ", x2);
        SINO
            SI (D = 0) ENTONCES
                x1 := -b / (2 * a);
                ESCRIBIR("una raiz real doble: ", x1);
            SINO
                ESCRIBIR("no tiene raices reales");
            FIN_SI
        FIN_SI
        ESCRIBIR("");

        // ────────────────────────────────────────────────────────────────────
        // EJERCICIO 3 (Guia 1.1.5.3) — Precio PC + impresora
        //
        //   PC $500, impresora $200. Descuento por cantidad de PCs:
        //   1 a 4 sin descuento, 5 a 9 el 5%, 10 o mas el 10%.
        //   Si se compra al menos una PC, la impresora va al 50%.
        //   Al total se le suma el 21% de IVA.
        // ────────────────────────────────────────────────────────────────────
        ESCRIBIR("── Ejercicio 3: precio PC + impresora ──");

        ESCRIBIR("cuantas PCs y cuantas impresoras:");
        LEER(cant_pc, cant_imp);

        // Los precios son dato del enunciado, no del usuario
        precio_pc  := 500;
        precio_imp := 200;

        SI (cant_pc >= 10) ENTONCES
            desc := 0.10;
        SINO
            SI (cant_pc >= 5) ENTONCES
                desc := 0.05;
            SINO
                desc := 0;
            FIN_SI
        FIN_SI

        subtotal_pc := cant_pc * precio_pc * (1 - desc);

        SI (cant_pc >= 1) ENTONCES
            subtotal_imp := cant_imp * precio_imp * 0.5;
        SINO
            subtotal_imp := cant_imp * precio_imp;
        FIN_SI

        total := (subtotal_pc + subtotal_imp) * 1.21;

        ESCRIBIR(cant_pc, " PCs con ", desc * 100, "% de descuento: $", subtotal_pc);
        ESCRIBIR(cant_imp, " impresoras: $", subtotal_imp);
        ESCRIBIR("total con IVA: $", total);
        ESCRIBIR("");

        // ────────────────────────────────────────────────────────────────────
        // EJERCICIO 4 — Condicion de un alumno
        //
        //   Con tres notas, calcular el promedio e informar la condicion:
        //   >= 6 aprobado, entre 4 y 5.99 recuperatorio, si no desaprobado.
        // ────────────────────────────────────────────────────────────────────
        ESCRIBIR("── Ejercicio 4: condicion del alumno ──");

        ESCRIBIR("las tres notas del alumno:");
        LEER(n1, n2, n3);

        prom := (n1 + n2 + n3) / 3;

        ESCRIBIR("notas: ", n1, " ", n2, " ", n3);
        ESCRIBIR("promedio: ", prom);

        SI (prom >= 6) ENTONCES
            ESCRIBIR("condicion: APROBADO");
        SINO
            SI (prom >= 4) ENTONCES
                ESCRIBIR("condicion: RECUPERATORIO");
            SINO
                ESCRIBIR("condicion: DESAPROBADO");
            FIN_SI
        FIN_SI
        ESCRIBIR("");

        // ────────────────────────────────────────────────────────────────────
        // EJERCICIO 5 (BOSS) — Registro de notas del curso
        //
        //   Sobre las notas del curso, calcular:
        //     a) cuantos aprobados (>= 6) y cuantos desaprobados
        //     b) el promedio general
        //     c) la nota mas alta
        //
        //   ESTE es el enunciado ORIGINAL: se cargan notas hasta que llega el
        //   centinela -1, y NO se sabe de antemano cuantas van a ser. Con los
        //   datos fijos en el codigo esto era imposible y habia que reemplazarlo
        //   por un arreglo de tamanio conocido. Con LEER, el ejercicio es el que
        //   toma la catedra.
        //
        //   El patron es el de siempre: se lee ANTES de entrar al ciclo, y la
        //   ultima instruccion del ciclo lee el siguiente. Asi el centinela se
        //   evalua sin haber entrado con el.
        // ────────────────────────────────────────────────────────────────────
        ESCRIBIR("── Ejercicio 5 (BOSS): registro de notas ──");
        ESCRIBIR("cargue las notas del curso, -1 para terminar (maximo 12):");

        cant := 0;
        suma := 0;
        curso.aprobados    := 0;
        curso.desaprobados := 0;
        curso.maxima       := -1;

        LEER(nota);

        // La segunda condicion NO es decoracion: el arreglo llega hasta 12 y
        // sin ella la nota 13 se escribiria fuera de rango. El evaluador lo
        // cortaria con un error, pero el algoritmo estaria mal igual.
        MIENTRAS (nota <> -1) Y (cant < 12) HACER
            cant := cant + 1;
            notas[cant] := nota;
            suma := suma + nota;

            SI (nota >= 6) ENTONCES
                curso.aprobados := curso.aprobados + 1;
            SINO
                curso.desaprobados := curso.desaprobados + 1;
            FIN_SI

            SI (nota > curso.maxima) ENTONCES
                curso.maxima := nota;
            FIN_SI

            LEER(nota);
        FIN_MIENTRAS

        // Dividir por cant sin preguntar seria dividir por cero el dia que
        // alguien cierre la carga sin ingresar ninguna nota.
        SI (cant > 0) ENTONCES
            curso.promedio := suma / cant;

            ESCRIBIR("alumnos: ", cant);
            ESCRIBIR("a) aprobados: ", curso.aprobados, "   desaprobados: ", curso.desaprobados);
            ESCRIBIR("b) promedio general: ", curso.promedio);
            ESCRIBIR("c) nota maxima: ", curso.maxima);
            ESCRIBIR("");

            // ── Verificacion: los dos grupos tienen que sumar el total ──
            SI (curso.aprobados + curso.desaprobados = cant) ENTONCES
                ESCRIBIR("control: los ", cant, " alumnos estan contados");
            SINO
                ESCRIBIR("ERROR: faltan alumnos en la cuenta");
            FIN_SI
        SINO
            ESCRIBIR("no se cargo ninguna nota");
        FIN_SI

        ESCRIBIR("");
        ESCRIBIR("===== fin del parcial =====");
FIN_ACCION

// Datos de ejemplo: los mismos que antes estaban fijos en el codigo.
// Una linea por dato — el bloque de abajo se manda tal cual por la entrada, asi
// que NO puede llevar texto explicativo adentro: seria leido como un valor.
// ── ENTRADA ─────────────────────────────────────────────────────────────────
// 1000
// 0.04
// 2026
// 2031
// 1
// -5
// 6
// 7
// 2
// 7
// 4
// 5
// 8
// 4
// 10
// 6
// 2
// 7
// 5
// 9
// 6
// 3
// 10
// 7
// -1
