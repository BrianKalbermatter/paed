// Ordenamiento por burbuja (metodo de intercambio).
//
// Este es el ejercicio que rompe un interprete mal hecho, por dos motivos:
//
//   1. PARA anidado. El PARA de adentro tiene que volver a arrancar en cada
//      vuelta del de afuera. Si la marca de "ya inicialice" fuera una sola
//      bandera global, el interno arrancaria una sola vez y el arreglo
//      quedaria a medio ordenar.
//
//   2. A[j] y A[j+1] como DESTINO de asignacion. El indice es una expresion
//      que cambia en cada vuelta, asi que no se puede resolver al parsear.

ACCION ordenamiento_burbuja ES
    AMBIENTE
        A: ARREGLO[1..8] DE ENTERO;
        n: ENTERO;
        i: ENTERO;
        j: ENTERO;
        tmp: ENTERO;
        cambios: ENTERO;
    PROCESO
        n := 8;

        A[1] := 34;
        A[2] := 7;
        A[3] := 91;
        A[4] := 12;
        A[5] := 55;
        A[6] := 3;
        A[7] := 68;
        A[8] := 20;

        ESCRIBIR("-- burbuja --");

        cambios := 0;

        PARA i := 1 HASTA n - 1 HACER
            PARA j := 1 HASTA n - i HACER
                SI (A[j] > A[j + 1]) ENTONCES
                    tmp := A[j];
                    A[j] := A[j + 1];
                    A[j + 1] := tmp;
                    cambios := cambios + 1;
                FIN_SI
            FIN_PARA
        FIN_PARA

        ESCRIBIR("intercambios: ", cambios);

        PARA i := 1 HASTA n HACER
            ESCRIBIR("A[", i, "] = ", A[i]);
        FIN_PARA

        // Verificacion: si quedo ordenado, cada uno es <= al que sigue.
        // Se recorre hasta n-1 porque se mira de a pares.
        ordenado := V;
        PARA i := 1 HASTA n - 1 HACER
            SI (A[i] > A[i + 1]) ENTONCES
                ordenado := F;
            FIN_SI
        FIN_PARA

        SI (ordenado) ENTONCES
            ESCRIBIR("quedo ordenado");
        SINO
            ESCRIBIR("ERROR: no quedo ordenado");
        FIN_SI
FIN_ACCION

// ── SALIDA ESPERADA ─────────────────────────────────────────────────────────
// -- burbuja --
// intercambios: 14
// A[1] = 3
// A[2] = 7
// A[3] = 12
// A[4] = 20
// A[5] = 34
// A[6] = 55
// A[7] = 68
// A[8] = 91
// quedo ordenado
