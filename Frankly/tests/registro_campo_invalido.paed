// Un campo que el registro NO declara se rechaza.
//
// Este programa FALLA a proposito. Sin este chequeo el registro no serviria de
// nada: como por dentro los campos se aplanan a variables normales, 'p.vz'
// simplemente naceria en su primera asignacion, igual que un escalar, y
// declarar el tipo no impediria absolutamente nada.
//
// Por eso un campo NO nace al asignarlo: se crean todos al declarar la
// variable, y el que no esta, no existe.

ACCION registro_campo_invalido ES
    AMBIENTE
        vector2 = REGISTRO
            vx: REAL;
            vy: REAL;
        FIN_REGISTRO

        p: vector2;
    PROCESO
        p.vx := 1;
        p.vy := 2;
        ESCRIBIR("los campos validos andan: ", p.vx, " ", p.vy);

        // vz no existe en vector2
        p.vz := 3;
FIN_ACCION

// ── SALIDA ESPERADA ─────────────────────────────────────────────────────────
// los campos validos andan: 1 2
// Frankly/tests/registro_campo_invalido.paed:25: error: 'p' no tiene un campo 'vz'
