# Bloque de PAED para ~/.config/helix/languages.toml
# Copiá esto al final de tu languages.toml y ajustá la ruta de `source`.

[[language]]
name = "paed"
scope = "source.paed"
file-types = ["paed"]
comment-token = "//"
indent = { tab-width = 4, unit = "    " }
# Sin language server: el que valida PAED es build/paedrun, desde la terminal.

[[grammar]]
name = "paed"
source = { path = "/home/devkbtj/proyectos/VimMon/paed/helix" }
