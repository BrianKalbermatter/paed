// El patron de recorrido de un archivo, de punta a punta y tocando el disco.
//
//     ABRIR E/(arch);
//     LEER(arch, reg);
//     MIENTRAS NO FDA(arch) HACER
//         // procesar reg
//         LEER(arch, reg);
//     FIN_MIENTRAS
//     CERRAR(arch);
//
// El LEER de antes del MIENTRAS no sobra: es la LECTURA ADELANTADA, y sin ella
// FDA no sabe si el archivo estaba vacio desde el principio. El LEER de abajo
// del ciclo es el que termina poniendo FDA en verdadero.
//
// Este programa CREA su propio archivo, lo carga, lo cierra y despues lo
// recorre. Asi no depende de ningun .csv guardado en el repo: el dato de
// entrada lo produce el mismo test.
//
// El .csv queda en tests/arch.csv y se puede abrir en una planilla — que era
// justamente el motivo de elegir CSV (PAED.md §2.6).

ACCION archivos_patron_fda ES
AMBIENTE
    alumno = REGISTRO
        legajo: ENTERO;
        nombre: AN(20);
        nota: REAL;
    FIN_REGISTRO

    arch: ARCHIVO DE alumno ORDENADO POR legajo;
    reg: alumno;
    cant: ENTERO;
    suma: REAL;
PROCESO
    // ── Cargarlo ────────────────────────────────────────────────────────
    // CREAR escribe la fila de encabezado con los campos del REGISTRO.
    CREAR(arch);

    reg.legajo := 101; reg.nombre := 'Ana'; reg.nota := 8.5;
    ESCRIBIR(arch, reg);

    reg.legajo := 205; reg.nombre := 'Bruno'; reg.nota := 6;
    ESCRIBIR(arch, reg);

    reg.legajo := 317; reg.nombre := 'Carla'; reg.nota := 9.5;
    ESCRIBIR(arch, reg);

    CERRAR(arch);

    // ── Recorrerlo ──────────────────────────────────────────────────────
    cant := 0;
    suma := 0;

    ABRIR E/(arch);
    LEER(arch, reg);

    MIENTRAS (NO FDA(arch)) HACER
        cant := cant + 1;
        suma := suma + reg.nota;
        ESCRIBIR("  ", reg.legajo, " ", reg.nombre, " ", reg.nota);
        LEER(arch, reg);
    FIN_MIENTRAS

    CERRAR(arch);

    ESCRIBIR("registros leidos: ", cant);
    ESCRIBIR("promedio: ", suma / cant);
FIN_ACCION

// ── SALIDA ESPERADA ─────────────────────────────────────────────────────────
//   101 Ana 8.5
//   205 Bruno 6
//   317 Carla 9.5
// registros leidos: 3
// promedio: 8
