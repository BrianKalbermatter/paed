// Lo que el interprete NO deja pasar en silencio con las secuencias.
//
// Cada uno de estos es un error real de parcial, y todos comparten la misma
// forma: si se los deja pasar, el programa sigue andando y da un resultado
// equivocado tres instrucciones mas abajo, donde ya no se ve la causa.
//
// El mas importante es avanzar despues del fin. En AED el bucle se corta con
// NFDS, asi que un AVZ de mas significa que el corte esta mal escrito — y sin
// este chequeo devolveria un dato inventado y el bucle seguiria como si nada.
//
// OJO — CORTADO POR EL CORTE DE EJECUCION (2026-08-14).
//
// Este archivo era un CATALOGO: probaba varios mensajes de error de una sola
// corrida. Desde que un error de runtime corta la ejecucion, solo se verifica
// el PRIMERO, y los de mas abajo quedaron sin probar.
//
// No se partio en varios archivos a proposito: casi todos esos errores son
// ESTATICOS reportados tarde (el parser ya sabe que '"hola"' no es un destino y
// que un registro no tiene tal campo). El arreglo de fondo es moverlos al
// parser, donde reportar de a muchos SI corresponde — y ahi el catalogo vuelve
// a funcionar solo. Esta en el KANBAN.

ACCION secuencia_errores ES
    AMBIENTE
        sec: SECUENCIA DE ENTERO;
        secSal: SECUENCIA DE SALIDA;
        n: ENTERO;

    PROCESO
        // 1. Avanzar sin haber arrancado
        AVZ(sec, n);

        // 2. Arrancar una secuencia de salida
        ARR(secSal);

        // 3. Crear una secuencia de entrada
        CREAR(sec);

        // 4. Grabar en una secuencia que no se creo
        ESCRIBIR(secSal, 1);

        // 5. Preguntar por el fin de una que no arranco
        SI FDS(sec) ENTONCES
            ESCRIBIR("nunca llega");
        FIN_SI

        // Ahora si, bien: dos elementos y el avance que la deja en FDS.
        ARR(sec); AVZ(sec, n);
        AVZ(sec, n);
        AVZ(sec, n);
        ESCRIBIR("ultimo leido: ", n);

        // 6. Uno mas, despues del fin
        AVZ(sec, n);
FIN_ACCION

// ── SECUENCIA sec ──
// 7 9

// ── SALIDA ESPERADA ─────────────────────────────────────────────────────────
// tests/secuencia_errores.paed:31: error: hay que arrancar 'sec' antes de avanzarla: falta ARR(sec)
// tests/secuencia_errores.paed: se corta la ejecucion: despues del primer error el estado ya no es confiable
