// El modo de apertura de la catedra: ABRIR E/(arch).
//
// Las cuatro formas de este test son las que aparecen en el material, y las
// cuatro son la misma instruccion — el espacio no cuenta y la mayuscula tampoco:
//
//     ABRIR E/(entra)      pegado, como en TEMAS_7-10:132
//     ABRIR s/ (sale)      con espacio y en minuscula, como en el corpus de UTN
//     ABRIRe/s(ambos)      sin ningun espacio, como en el template de ACT INDEX
//     ABRIR /S(viejo)      con la barra del otro lado, como en la diapo del Tema 8
//
// El programa no llega a correr de verdad: el manejo de archivos en disco
// todavia no existe. Que la salida sean los errores del INTERPRETE y no del
// PARSER es justamente lo que prueba este test — si el modo no se entendiera,
// el error diria "nombre de procedimiento invalido".
//
// OJO — CORTADO POR EL CORTE DE EJECUCION (2026-08-14).
//
// Este archivo era un CATALOGO: probaba varios mensajes de error de una sola
// corrida. Desde que un error de runtime corta la ejecucion, solo se verifica
// el PRIMERO, y los de mas abajo quedaron sin probar.
//
// No se partio en varios archivos a proposito: casi todos esos errores son
// ESTATICOS reportados tarde (el parser ya sabe que '"hola"' no es un destino y
// que un registro no tiene tal campo). El arreglo de fondo es moverlos al
// parser, donde reportar de a muchos SI corresponde — y ahi el catalogo vuelve
// a funcionar solo. Esta en el KANBAN.

ACCION modos_de_apertura ES
    AMBIENTE
        alumno = REGISTRO
            legajo: N(6);
        FIN_REGISTRO

        a: alumno;
        entra: ARCHIVO DE alumno;
        sale:  ARCHIVO DE alumno;
        ambos: ARCHIVO DE alumno;
        viejo: ARCHIVO DE alumno;

    PROCESO
        ABRIR E/(entra);
        LEER(entra, a);

        ABRIR s/ (sale);
        ESCRIBIR(sale, a);

        ABRIRe/s(ambos);
        LEER(ambos, a);
        ESCRIBIR(ambos, a);

        ABRIR /S(viejo);
        ESCRIBIR(viejo, a);
FIN_ACCION

// ── SALIDA ESPERADA ─────────────────────────────────────────────────────────
// tests/archivos_modos.paed:41: error: no existe el archivo 'entra.csv': hay que crearlo con CREAR(entra) antes de abrirlo
// tests/archivos_modos.paed: se corta la ejecucion: despues del primer error el estado ya no es confiable
