// Fixture de errores: cada linea de PROCESO tiene exactamente un error.
// Sirve para verificar que el parser NUNCA ignora en silencio.
ACCION errores ES
AMBIENTE
    cubo1: CUBO;
PROCESO
    CUBO(nombre = cubo1, posicion = (0,0,0), color = #ff0000);
    MOVER(cubo1, posicion = (1,1,1));
    MOVERR(nombre = cubo1, posicion = (1,1,1));
    COLOR(nombre = cubo1, valor = #00ff00);
    MOVER(nombre = cubo1, posicion = 1,1,1);
    ESCALAR(nombre = cubo1)
    MOVER(nombre = fantasma, posicion = (2,2,2));
    ESCRIBIR("resultado: ", 3 = 3);
    ESCRIBIR("resultado: ", 3 == 3);
    ARR(3 < 4);
FIN_ACCION

//
// CAMBIO 2026-08-17: la linea 12 (`ESCALAR(nombre = cubo1)`) probaba que faltar
// el ';' final era un error. Ya no lo es: el ';' del final paso a ser OPCIONAL
// cuando se decidio que manda la catedra, que lo escribe de las dos formas
// (Si.txt tiene una linea con ';' y la de arriba sin el).
//
// La linea SIGUE teniendo exactamente un error, y por eso sigue sirviendo en
// este fixture: ahora parsea bien y lo que falta es el parametro 'factor'. El
// ';' como SEPARADOR de varias sentencias en un renglon no cambio, y lo prueba
// tests/sentencias_en_una_linea.paed.

// ── LIBRERIA escena
// Este test usa MOVER y COLOR, que NO son del lenguaje: son de la libreria de
// escena de VimMon. Sin declararla, el parser diria "procedimiento desconocido"
// para TODOS y el test dejaria de probar lo que vino a probar.

