// EJERCICIO 10 — texto
//
// `AN(20)` es el tipo "hasta 20 caracteres". El `+` sobre texto CONCATENA, y
// concatenar no agrega espacios: los espacios son caracteres y hay que
// ponerlos.
//
// Comparar texto se hace por ASCII, caracter por caracter — no por largo. Y
// distingue mayusculas: "ana" y "Ana" NO son iguales.
//
// Este programa imprime el nombre todo pegado. Arreglalo.

ACCION cadenas ES
AMBIENTE
    nombre: AN(20);
    apellido: AN(20);
    completo: AN(45);
    clave: AN(20);
PROCESO
    nombre := "Ada";
    apellido := "Lovelace";
    completo := nombre + apellido;
    ESCRIBIR("nombre completo: ", completo);

    LEER(clave);
    SI (clave = "abrite sesamo") ENTONCES
        ESCRIBIR("pasa");
    SINO
        ESCRIBIR("clave incorrecta");
    FIN_SI

    SI ("Ana" < "Beto") ENTONCES
        ESCRIBIR("el texto se compara por ASCII: Ana va antes que Beto");
    FIN_SI
FIN_ACCION

// ── PISTA ───────────────────────────────────────────────────────────────────
// Un espacio es un caracter como cualquier otro: " " es un texto de largo 1, y
// se puede concatenar igual que los demas.

// ── ENTRADA ─────────────────────────────────────────────────────────────────
// abrite sesamo

// ── SALIDA ESPERADA ─────────────────────────────────────────────────────────
// nombre completo: Ada Lovelace
// pasa
// el texto se compara por ASCII: Ana va antes que Beto
