ACCION para ES
AMBIENTE
    i: ENTERO;
    n: ENTERO;
    fact: ENTERO;
PROCESO
    n := 5;

    ESCRIBIR("-- tabla del ", n, " --");
    PARA i := 1 HASTA 10 HACER
        ESCRIBIR(n, " x ", i, " = ", n * i);
    FIN_PARA

    ESCRIBIR("-- cuenta regresiva --");
    PARA i := 5 HASTA 1; -1 HACER
        ESCRIBIR(i);
    FIN_PARA

    fact := 1;
    PARA i := 1 HASTA n HACER
        fact := fact * i;
    FIN_PARA
    ESCRIBIR(n, "! = ", fact);
FIN_ACCION

// ── SALIDA ESPERADA ─────────────────────────────────────────────────────────
// -- tabla del 5 --
// 5 x 1 = 5
// 5 x 2 = 10
// 5 x 3 = 15
// 5 x 4 = 20
// 5 x 5 = 25
// 5 x 6 = 30
// 5 x 7 = 35
// 5 x 8 = 40
// 5 x 9 = 45
// 5 x 10 = 50
// -- cuenta regresiva --
// 5
// 4
// 3
// 2
// 1
// 5! = 120
