ACCION escribir ES
PROCESO
    ESCRIBIR("Hola, PAED")
    ESCRIBIR("El ';' separa: "); ESCRIBIR("dos instrucciones en un renglon")
    ESCRIBIR("ESCRIBIR pega sus argumentos: ", 2, " + ", 2, " = ", 4);
FIN_ACCION

